{
  "name": "storybook-genui",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook GenUI — Server Generated UI framework with GraphQL + PWA, mobile-first, offline-first, AI-first. Monorepo.",
  "workspaces": ["packages/*", "apps/*", "tools/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "gen": "node tools/cli/scaffold.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "eslint": "^9.0.0",
    "@storybook/cli": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
