{
  "name": "storybook-genui",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook GenUI — Server Generated UI framework with GraphQL + PWA, mobile-first, offline-first, AI-first. Monorepo.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "gen": "node tools/cli/scaffold.mjs"
  },
  "storybook": {
    "core": {
      "allowedHosts": true
    }
  },
  "devDependencies": {
    "@rollup/rollup-android-arm64": "^4.60.3",
    "@rollup/wasm-node": "^4.60.3",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-viewport": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "rollup@4.60.3": "patches/rollup@4.60.3.patch"
    }
  }
}
